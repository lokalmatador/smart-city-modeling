	def compile(Iterable<CommunicationLink> links){
		var linksList = new ArrayList()
		var distinct = new HashSet()
		for (link: links){
			linksList.add(link) // used to persist the iterator
			distinct.add(link.type)
		}
		
		// for each distinct create array of datatypes
		var linkDataMap = new HashMap()
		for (type:distinct){
			linkDataMap.put(type, "[")
			for(link:linksList){
				if(link.type === type){
					linkDataMap.put(type, linkDataMap.get(type) + "'" + link.datatype.toString + "'" + ", ")				
				}
			}
			val len = linkDataMap.get(type).length
			if (len > 2){
				linkDataMap.put(type, linkDataMap.get(type).substring(0, len - 2))
			}
			linkDataMap.put(type, linkDataMap.get(type) + "]")
		}
		
		
		'''
		«FOR linkType:linkDataMap.keySet»
		from communications.«linkType.toString.toLowerCase»_comm import «linkType.toString.toUpperCase»
		«linkType.toString» = self.addSubModel(«linkType.toString.toUpperCase»("«linkType.toString»", «linkDataMap.get(linkType)»))
